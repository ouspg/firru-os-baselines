# Debian golden set (bl-linux.sh): the netinst ISO's installer, packages from
# snapshot.debian.org at one fixed timestamp through the host's proxy (the
# guest reaches nothing else). Stock choices where the installer offers one
# (guided regular partitioning, the standard and ssh-server tasks unless the
# job says otherwise). The stock sources are put back before the first boot.

d-i debian-installer/locale string en_US.UTF-8
d-i keyboard-configuration/xkb-keymap select us
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string baseline-debian
d-i netcfg/get_domain string
d-i netcfg/hostname string baseline-debian
# The isolated bridge has no router (the proxy is on the same subnet); an
# egress run's NAT bridge has one.
d-i netcfg/no_default_route boolean @NODEFAULT@
# Nor a name server: nothing to resolve, the mirror is an address.
d-i netcfg/get_nameservers string
d-i hw-detect/load_firmware boolean false

d-i mirror/country string manual
d-i mirror/http/hostname string @HOSTPORT@
d-i mirror/http/directory string @PREFIX@/debian/@SNAPSHOT@
d-i mirror/http/proxy string
d-i mirror/suite string @SUITE@
d-i apt-setup/services-select multiselect security, updates
d-i apt-setup/security_host string @HOSTPORT@
d-i apt-setup/security_path string @PREFIX@/debian-security/@SNAPSHOT@
d-i apt-setup/non-free-firmware boolean true
d-i apt-setup/cdrom/set-first boolean false
d-i apt-setup/disable-cdrom-entries boolean true

d-i passwd/root-login boolean false
d-i passwd/user-fullname string debian
d-i passwd/username string debian
d-i passwd/user-password-crypted password @PWHASH@

d-i clock-setup/utc boolean true
d-i time/zone string UTC
d-i clock-setup/ntp boolean false

d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman-efi/non_efi_system boolean true

tasksel tasksel/first multiselect @TASKS@
d-i pkgsel/include string @APTPKGS@
d-i pkgsel/upgrade select full-upgrade
popularity-contest popularity-contest/participate boolean false
d-i grub-installer/only_debian boolean true
d-i grub-installer/bootdev string default

# A snapshot's security and updates Release files carry Valid-Until (a week):
# the installer's apt accepts them while it installs. Set by a base-installer
# hook (after debootstrap, before apt-setup), removed again by late_command.
d-i preseed/early_command string mkdir -p /usr/lib/base-installer.d; \
  printf '#!/bin/sh\nmkdir -p /target/etc/apt/apt.conf.d\necho "Acquire::Check-Valid-Until \\"false\\"; Acquire::Retries \\"20\\";" > /target/etc/apt/apt.conf.d/99bl-snapshot\n' > /usr/lib/base-installer.d/99bl-snapshot; \
  chmod +x /usr/lib/base-installer.d/99bl-snapshot

# Back to stock: the sources the installer wrote, with the snapshot proxy's
# URLs put back to the archive's own (format and components as written), no
# snapshot lists, no installer apt settings; then the stub (baseline-job.sh,
# its units) in the target.
d-i preseed/late_command string \
  for f in /target/etc/apt/sources.list /target/etc/apt/sources.list.d/*; do [ -f "$f" ] && sed -i -e 's|http://@HOSTPORT@@PREFIX@/debian-security/@SNAPSHOT@|http://security.debian.org/debian-security|g' -e 's|http://@HOSTPORT@@PREFIX@/debian/@SNAPSHOT@|http://deb.debian.org/debian|g' "$f"; done; \
  rm -f /target/etc/apt/apt.conf.d/99bl-snapshot /target/var/lib/apt/lists/@LISTS@*; \
  cp /bl-stub.sh /target/tmp/bl-stub.sh; chroot /target /bin/sh /tmp/bl-stub.sh; rm -f /target/tmp/bl-stub.sh

d-i finish-install/reboot_in_progress note
d-i debian-installer/exit/poweroff boolean true
