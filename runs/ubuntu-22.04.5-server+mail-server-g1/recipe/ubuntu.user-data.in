#cloud-config
# Ubuntu golden set (bl-linux.sh): the server or desktop ISO, packages from
# snapshot.ubuntu.com at one fixed timestamp through the host's proxy (the
# guest reaches nothing else). The stock sources are put back before the
# first boot, so the installed system points at the archive as usual.
autoinstall:
  version: 1
  refresh-installer:
    update: false
  source:
    id: @SOURCEID@
  apt:
    geoip: false
    preserve_sources_list: false
    mirror-selection:
      primary:
      - uri: @MIRROR@
    # The security pocket too: by default it goes to security.ubuntu.com,
    # which the guest cannot reach.
    security:
    - arches: [default]
      uri: @MIRROR@
    fallback: abort
    # Retries with backoff for the installer's own apt too (an egress run
    # fetches from snapshot.ubuntu.com directly, which answers 503 under load).
    # curtin writes this into the target; a late-command removes it again.
    conf: |
      Acquire::Retries "20";
      Acquire::Retries::Delay::Maximum "60";
  identity:
    hostname: baseline-ubuntu
    username: ubuntu
    password: '@PWHASH@'
  ssh:
    install-server: @SSH@
  # Subiquity installs offline (ignoring the mirror) when there is no default
  # route, and the isolated bridge has none. The installer alone gets one, to
  # the host, which forwards nothing; the late-commands put back the netplan
  # file Subiquity writes for a plain DHCP install.
  network:
    version: 2
    ethernets:
      bl:
        match:
          name: "en*"
        dhcp4: true
        routes:
        - to: default
          via: @HOSTIP@
  # Each ISO's default layout: LVM on the server, a plain partition on the
  # desktop.
  storage:
    layout:
      name: @LAYOUT@
  # Retries with apt's backoff: an egress run fetches from snapshot.ubuntu.com
  # directly, which answers 503 when several runs download at once.
  # The variant's packages go in with plain apt-get in the target, while its
  # apt still points at the snapshot proxy (the next command restores the
  # stock sources): Subiquity's own packages list fails on tasks
  # (lamp-server^), apt-get resolves them as an administrator's apt would.
  packages: []
  late-commands:
  - |
    [ -z "@APTPKGS@" ] || { curtin in-target --target=/target -- sh -c 'apt-get -o Acquire::Retries=20 update && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=20 -o Acquire::Retries::Delay::Maximum=60 install -y @APTPKGS@' > /target/var/log/bl-packages.log 2>&1; echo "bl_packages_rc=$?" >> /target/var/log/bl-packages.log; }; true
  # The release's stock sources: deb822 since 24.04, sources.list before.
  - |
    if [ @SUITE@ = jammy ]; then
    cat > /target/etc/apt/sources.list <<'S'
    deb http://archive.ubuntu.com/ubuntu/ jammy main restricted universe multiverse
    deb http://archive.ubuntu.com/ubuntu/ jammy-updates main restricted universe multiverse
    deb http://archive.ubuntu.com/ubuntu/ jammy-backports main restricted universe multiverse
    deb http://security.ubuntu.com/ubuntu/ jammy-security main restricted universe multiverse
    S
    else
    cat > /target/etc/apt/sources.list.d/ubuntu.sources <<'S'
    Types: deb
    URIs: http://archive.ubuntu.com/ubuntu/
    Suites: @SUITE@ @SUITE@-updates @SUITE@-backports
    Components: main restricted universe multiverse
    Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

    Types: deb
    URIs: http://security.ubuntu.com/ubuntu/
    Suites: @SUITE@-security
    Components: main restricted universe multiverse
    Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
    S
    fi
  - rm -f /target/var/lib/apt/lists/@LISTS@*
  - rm -f /target/etc/apt/apt.conf.d/94curtin-config
  # The server: the netplan file Subiquity writes for a plain DHCP install.
  # The desktop: NetworkManager as its stock netplan says, without the
  # installer's route.
  - |
    nic=$(ls /sys/class/net | grep '^en' | head -1)
    if [ @KIND@ = desktop ]; then
    for f in $(grep -l '@HOSTIP@' /target/etc/netplan/* 2>/dev/null); do echo "bl: removed $f"; rm -f "$f"; done
    [ -e /target/etc/netplan/01-network-manager-all.yaml ] || { printf "# Let NetworkManager manage all devices on this system\nnetwork:\n  version: 2\n  renderer: NetworkManager\n" > /target/etc/netplan/01-network-manager-all.yaml; chmod 600 /target/etc/netplan/01-network-manager-all.yaml; }
    else
    # The file the installer wrote with its route (26.04: 00-installer-config.yaml)
    # becomes plain DHCP under its own name; with none (22.04, 24.04: cloud-init
    # renders it at first boot), the 50-cloud-init.yaml those releases have.
    files=$(grep -l '@HOSTIP@' /target/etc/netplan/* 2>/dev/null); [ -n "$files" ] || files=/target/etc/netplan/50-cloud-init.yaml
    for f in $files; do
    printf "# This is the network config written by 'subiquity'\nnetwork:\n  ethernets:\n    %s:\n      dhcp4: true\n  version: 2\n" "$nic" > "$f"
    chmod 600 "$f"; echo "bl: DHCP-only $f"
    done
    fi
    # cloud-init re-renders netplan on first boot from the installer's copy
    # of the network section: that copy gets the same DHCP-only config.
    for f in $(grep -l '@HOSTIP@' /target/etc/cloud/cloud.cfg.d/* 2>/dev/null); do
      echo "bl: route scrubbed from $f"
      printf "network:\n  ethernets:\n    %s:\n      dhcp4: true\n  version: 2\n" "$nic" > "$f"
    done
  - echo @STUB64@ | base64 -d | chroot /target /bin/sh
  shutdown: poweroff
