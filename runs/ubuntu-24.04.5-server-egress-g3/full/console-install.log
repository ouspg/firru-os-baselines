start:  subiquity/Late/run/command_4: nic=$(ls /sys/class/net | grep '^en' | head -1)
printf "# This is the network config written by 'subiquity'\nnetwork:\n  ethernets:\n    %s:\n      dhcp4: true\n  version: 2\n" "$nic" > /target/etc/netplan/50-cloud-init.yaml
chmod 600 /target/etc/netplan/50-cloud-init.yaml
# cloud-init re-renders netplan on first boot from the installer's copy
# of the network section: that copy gets the same DHCP-only config.
for f in $(grep -l '192.168.122.1' /target/etc/cloud/cloud.cfg.d/* 2>/dev/null); do
  echo "bl: route scrubbed from $f"
  printf "network:\n  ethernets:\n    %s:\n      dhcp4: true\n  version: 2\n" "$nic" > "$f"
done

