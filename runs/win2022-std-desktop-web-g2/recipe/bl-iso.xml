<!-- Isolated network for sealed Windows baselines: no forwarding, so no
     internet (no Windows Update, no activation, no NCSI success), and no DNS
     server handed out. The host reaches the guest at 192.168.150.1 for nmap. -->
<network>
  <name>bl-iso</name>
  <bridge name='virbr-bl' stp='on' delay='0'/>
  <dns enable='no'/>
  <ip address='192.168.150.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='192.168.150.100' end='192.168.150.199'/>
    </dhcp>
  </ip>
</network>
