# Linux golden set 1 (2026-10-19): installed from the ISO per run, the
# variant's packages chosen at install time (pipeline/linux/bl-linux.sh).
# AlmaLinux offline from the DVD; Ubuntu through snapshot.ubuntu.com at one
# fixed timestamp. Variants as the 2026-10-01 runs, which they replace.
# NAME ENV=VALUE ... ; run by bin/run-list.sh.

# Untested paths first (add-on group, Ubuntu task, graphical), one per worker.
almalinux-9.8-web-server-g1          ISO=AlmaLinux-9.8-x86_64-dvd.iso SCAN=1 PACKAGES=@^minimal-environment;@web-server
ubuntu-24.04.5-server+lamp-server-g1        ISO=ubuntu-24.04.5-live-server-amd64.iso SCAN=1 SNAPSHOT=20261015T000000Z PACKAGES=lamp-server^
almalinux-9.8-workstation-g1         ISO=AlmaLinux-9.8-x86_64-dvd.iso SCAN=1 PACKAGES=@^workstation-product-environment GRAPHICS=vnc MEMORY=6144

almalinux-9.8-minimal-g1             ISO=AlmaLinux-9.8-x86_64-dvd.iso SCAN=1 PACKAGES=@^minimal-environment
